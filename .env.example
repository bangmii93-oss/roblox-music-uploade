# Isi lalu rename file ini jadi .env

# API key dari Roblox Creator Dashboard > Open Cloud
ROBLOX_API_KEY=

# Tipe creator yang upload: "User" atau "Group"
ROBLOX_CREATOR_TYPE=User

# User ID kamu (kalau CREATOR_TYPE=User) atau Group ID (kalau CREATOR_TYPE=Group)
ROBLOX_CREATOR_ID=

# Port lokal untuk server
PORT=3000
